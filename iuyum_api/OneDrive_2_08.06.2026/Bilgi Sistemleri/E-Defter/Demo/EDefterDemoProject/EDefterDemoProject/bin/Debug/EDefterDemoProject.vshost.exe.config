<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
    </startup>
    <system.serviceModel>
        <bindings>
            <basicHttpBinding>
                <binding name="BasicHttpBinding_ILedgerIntegration" maxReceivedMessageSize="2000000000">
                    <security mode="TransportWithMessageCredential" />
                </binding>
                <binding name="BasicHttpBinding_ILedgerIntegration1">
                    <security mode="TransportWithMessageCredential" />
                </binding>
            </basicHttpBinding>
        </bindings>
        <client>
            <endpoint address="https://efatura.uyumsoft.com.tr/Services/LedgerIntegration"
                binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_ILedgerIntegration"
                contract="eDefter.ILedgerIntegration" name="BasicHttpBinding_ILedgerIntegration" />
            <endpoint address="https://connect-test.crssoft.com/Services/LedgerIntegration"
                binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_ILedgerIntegration1"
                contract="Connect.ILedgerIntegration" name="BasicHttpBinding_ILedgerIntegration1" />
        </client>
    </system.serviceModel>
</configuration>